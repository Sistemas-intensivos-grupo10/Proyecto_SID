{
  "datasets": [
    {
      "name": "a13a9d57",
      "displayName": "kpis_dia",
      "queryLines": [
        "SELECT\r\n",
        "  (SELECT COUNT(DISTINCT mmsi) FROM clase10.equipo10.gold_trayectorias_diarias WHERE fecha = :fecha) AS buques_activos,\r\n",
        "  (SELECT COUNT(DISTINCT mmsi) FROM clase10.equipo10.gold_presencia_puertos   WHERE fecha = :fecha) AS buques_en_puerto,\r\n",
        "  (SELECT SUM(valor) FROM clase10.equipo10.ops_calidad_metricas WHERE fecha = :fecha AND metrica = 'filas_entrada') AS posiciones,\r\n",
        "  (SELECT ROUND(100 * SUM(CASE WHEN metrica = 'cuarentena' THEN valor END)\r\n",
        "                    / SUM(CASE WHEN metrica = 'filas_entrada' THEN valor END), 3)\r\n",
        "     FROM clase10.equipo10.ops_calidad_metricas WHERE fecha = :fecha) AS pct_cuarentena"
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "0f2e76dd",
      "displayName": "mapa_trafico",
      "queryLines": [
        "SELECT h3_r7, FIRST(lat) AS lat, FIRST(lon) AS lon,\r\n",
        "       SUM(posiciones) AS posiciones, MAX(buques) AS buques_hora_pico\r\n",
        "FROM clase10.equipo10.gold_trafico_celda_hora\r\n",
        "WHERE fecha = :fecha\r\n",
        "GROUP BY h3_r7\r\n",
        "HAVING SUM(posiciones) >= 50"
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "74299b68",
      "displayName": "ranking_puertos",
      "queryLines": [
        "WITH base AS (\n",
        "  SELECT\n",
        "    p.puerto,\n",
        "    p.pais,\n",
        "    p.mmsi,\n",
        "    p.horas_en_puerto,\n",
        "    COALESCE(d.categoria, 'Sin tipo') AS categoria\n",
        "  FROM\n",
        "    clase10.equipo10.gold_presencia_puertos p\n",
        "      LEFT JOIN clase10.equipo10.gold_dim_tipo_buque d\n",
        "        ON p.vessel_type BETWEEN d.codigo_min AND d.codigo_max\n",
        "  WHERE\n",
        "    p.fecha = :fecha\n",
        "),\n",
        "top15 AS (\n",
        "  SELECT\n",
        "    puerto,\n",
        "    COUNT(DISTINCT mmsi) AS buques_total\n",
        "  FROM\n",
        "    base\n",
        "  GROUP BY\n",
        "    puerto\n",
        "  ORDER BY\n",
        "    buques_total DESC\n",
        "  LIMIT 15\n",
        ")\n",
        "SELECT\n",
        "  b.puerto,\n",
        "  MIN(b.pais) AS pais,\n",
        "  b.categoria,\n",
        "  COUNT(DISTINCT b.mmsi) AS buques,\n",
        "  ROUND(SUM(b.horas_en_puerto), 1) AS horas_buque\n",
        "FROM\n",
        "  base b\n",
        "    JOIN top15 t\n",
        "      ON b.puerto = t.puerto\n",
        "GROUP BY\n",
        "  b.puerto,\n",
        "  b.categoria\n",
        "ORDER BY\n",
        "  MAX(t.buques_total) DESC,\n",
        "  b.categoria"
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6f07d0fc",
      "displayName": "buques_en_puerto",
      "queryLines": [
        "SELECT p.puerto, p.mmsi, p.vessel_name, COALESCE(d.categoria, 'Sin tipo') AS categoria,\r\n",
        "       p.primera_posicion, p.ultima_posicion, p.horas_en_puerto\r\n",
        "FROM clase10.equipo10.gold_presencia_puertos p\r\n",
        "LEFT JOIN clase10.equipo10.gold_dim_tipo_buque d ON p.vessel_type BETWEEN d.codigo_min AND d.codigo_max\r\n",
        "WHERE p.fecha = :fecha\r\n",
        "ORDER BY p.horas_en_puerto DESC"
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "d8901100",
      "displayName": "anomalias_dia",
      "queryLines": [
        "SELECT 'Salto de posición (MMSI posiblemente compartido)' AS tipo, mmsi, vessel_name,\r\n",
        "       saltos_anomalos AS eventos, v_impl_max_kn AS detalle\r\n",
        "FROM clase10.equipo10.gold_trayectorias_diarias\r\n",
        "WHERE fecha = :fecha AND saltos_anomalos > 0\r\n",
        "UNION ALL\r\n",
        "SELECT CONCAT('Calidad: ', REPLACE(metrica, 'cuarentena_', '')), NULL, NULL, valor, NULL\r\n",
        "FROM clase10.equipo10.ops_calidad_metricas\r\n",
        "WHERE fecha = :fecha AND metrica LIKE 'cuarentena\\\\_%' AND valor > 0\r\n",
        "ORDER BY eventos DESC"
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    }
  ],
